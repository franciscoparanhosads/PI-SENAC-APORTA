# Copie este arquivo para ".env" e ajuste se necessário.
# NUNCA commite o arquivo ".env" real (ele já está no .gitignore).

# Chave secreta usada para assinar os tokens JWT.
# Troque por um valor aleatório antes de usar fora do ambiente de desenvolvimento.
JWT_SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa

# Tempo de expiração do token, em minutos.
JWT_EXPIRE_MINUTES=120

# Caminho do banco de dados SQLite.
DATABASE_URL=sqlite:///./aporta.db

# Token opcional da brapi.dev — NÃO é necessário para os 4 tickers gratuitos
# (PETR4, MGLU3, VALE3, ITUB4). Deixe em branco por enquanto; preencha apenas
# se o grupo decidir expandir para outros ativos no futuro.
BRAPI_TOKEN=

# Origem permitida para chamadas do front-end (CORS).
FRONTEND_ORIGIN=http://localhost:5500
